{
  "name": "fast-harm-slow-repair",
  "version": "0.1.0",
  "description": "Draft evaluation protocol: does a healthcare AI workflow remain correctable after its record becomes wrong? Case and state schemas, a deterministic scorer, fixtures, and a preregistration draft.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "score": "bun run harness/score-fixture.ts",
    "validate": "bun run harness/validate-all.ts",
    "gold": "bun run harness/gold-all.ts",
    "prompt-audit": "bun run harness/prompt.ts",
    "gen:types": "bun run scripts/gen-types.ts",
    "pilot": "bun run harness/runner/run-pilot.ts",
    "rescore": "bun run harness/runner/rescore.ts",
    "taxonomy": "bun run harness/runner/taxonomy.ts",
    "diff": "bun run harness/runner/diff.ts",
    "export-sft": "bun run harness/runner/export-sft.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "json-schema-to-ts": "^3.1.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
